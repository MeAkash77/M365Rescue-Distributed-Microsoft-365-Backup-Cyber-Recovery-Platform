# Copy to .env (docker compose reads it automatically). NEVER commit real secrets.
ENCRYPTION_MASTER_KEY=change-me-or-64-hex-chars
API_KEYS=admin:change-admin-key,operator:change-operator-key,auditor:change-auditor-key
# Only needed for real Microsoft 365 tenants (see docs/graph-setup.md)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Enqueue backups for all tenants automatically, e.g. 1h (0 = disabled)
SCHEDULE_EVERY=0
